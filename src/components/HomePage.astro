---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, rootFor } from '../i18n/index.mjs';

const { lang = 'en' } = Astro.props;
const t = copy[lang];
const articlePath = lang === 'tr' ? '/tr/writing/sakin-bir-yer/' : '/writing/a-quieter-place/';
const projectPath = lang === 'tr' ? '/tr/projects/project-preview/' : '/projects/project-preview/';
---

<BaseLayout lang={lang} alternatePath={rootFor(lang === 'en' ? 'tr' : 'en')} description={`${t.introLead} ${t.introRest}`}>
  <div class="homepage">
    <section class="intro" aria-labelledby="intro-title">
      <h1 id="intro-title"><em>{t.introLead}</em> {t.introRest}</h1>
      <a class="resume-link" href="https://drive.google.com/file/d/1mxvh5EXonVqiuJ26tK6bfV4wSLn6u82S/view?usp=sharing" target="_blank" rel="noopener noreferrer">{t.nav.resume}</a>
    </section>

    <section class="plain-section" id="work" aria-labelledby="work-title">
      <h2 id="work-title">{t.nav.work}</h2>
      <div class="plain-links">
        <a href={projectPath}>{t.workPreview}</a>
        <a href="https://github.com/AhmetServet" target="_blank" rel="noopener noreferrer">{t.github}</a>
      </div>
    </section>

    <section class="plain-section" id="writing" aria-labelledby="writing-title">
      <h2 id="writing-title">{t.nav.writing}</h2>
      <div class="plain-links">
        <a href={articlePath}>{t.writingPreview}</a>
      </div>
    </section>

    <section class="plain-section connect-section" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">{t.nav.contact}</h2>
      <div class="plain-links">
        <a href={`mailto:${t.email}`}>{t.email}</a>
        <a href="https://www.linkedin.com/in/ahmetservetpolat/" target="_blank" rel="noopener noreferrer">{t.linkedin}</a>
      </div>
    </section>
  </div>
</BaseLayout>
