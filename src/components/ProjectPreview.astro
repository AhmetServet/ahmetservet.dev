---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, rootFor } from '../i18n/index.mjs';

const { lang = 'en' } = Astro.props;
const t = copy[lang];
const alternatePath = lang === 'en' ? '/tr/projects/project-preview/' : '/projects/project-preview/';
---

<BaseLayout lang={lang} title={`${t.projectHeading} — Ahmet Servet Polat`} description={t.projectLead} alternatePath={alternatePath}>
  <article class="detail-page project-page">
    <a class="back-link" href={rootFor(lang)}>{t.back}</a>
    <header class="detail-header">
      <h1>{t.projectHeading}</h1>
      <p class="detail-lead">{t.projectLead}</p>
    </header>
  </article>
</BaseLayout>
