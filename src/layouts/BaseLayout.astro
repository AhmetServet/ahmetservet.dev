---
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/global.css';
import AmbientBackground from '../components/backgrounds/AmbientBackground.jsx';
import { copy, rootFor } from '../i18n/index.mjs';

const { lang = 'en', title = 'Ahmet Servet Polat', description = 'Projects, writing, and a place to think in public.', alternatePath, animateBackground = true } = Astro.props;
const t = copy[lang];
const path = Astro.url.pathname;
const alternateHref = alternatePath || rootFor(lang === 'en' ? 'tr' : 'en');
const variant = import.meta.env.PUBLIC_BACKGROUND_EFFECT?.toLowerCase() === 'silk' ? 'silk' : 'grainient';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="darkreader-lock" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7e7e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang={lang === 'en' ? 'tr' : 'en'} href={new URL(alternateHref, Astro.site)} />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('color-theme');
        document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="ambient-background" data-static={!animateBackground ? 'true' : undefined} aria-hidden="true">
      {animateBackground && <AmbientBackground variant={variant} client:only="react" />}
    </div>
    <div class="page-frame">
      <header class="site-header shell">
        <a class="brand" href={rootFor(lang)}>Ahmet Servet Polat</a>
        <div class="header-controls">
          <div class="language-switch" aria-label={t.languageLabel}>
            <a href={lang === 'en' ? path : alternateHref} lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
            <span aria-hidden="true">/</span>
            <a href={lang === 'tr' ? path : alternateHref} lang="tr" aria-current={lang === 'tr' ? 'page' : undefined}>TR</a>
          </div>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label={t.theme.label} aria-pressed="false" data-light={t.theme.lightAction} data-dark={t.theme.darkAction}>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M12 2.75v2.25M12 19v2.25M21.25 12H19M5 12H2.75M18.54 5.46l-1.6 1.6M7.06 16.94l-1.6 1.6M18.54 18.54l-1.6-1.6M7.06 7.06l-1.6-1.6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" />
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M19.1 15.4A7.5 7.5 0 0 1 8.6 4.9 7.5 7.5 0 1 0 19.1 15.4Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" />
            </svg>
          </button>
        </div>
      </header>

      <main id="main" class="shell"><slot /></main>

      <footer class="site-footer shell">
        <span>© {new Date().getFullYear()} Ahmet Servet Polat</span>
      </footer>
    </div>
    <script>
      const button = document.querySelector('#theme-toggle');
      const lightText = button?.dataset.light;
      const darkText = button?.dataset.dark;
      const sync = () => {
        if (!button) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        button.setAttribute('aria-pressed', String(dark));
        button.setAttribute('aria-label', dark ? lightText : darkText);
      };
      sync();
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('color-theme', next); } catch { /* theme still works without storage */ }
        sync();
      });
    </script>
  </body>
</html>
